# Base URL of the WowMiles API server, without the /api/v1 suffix.
# https is required, except http://localhost, http://127.0.0.1 and http://10.0.2.2 (Android emulator) in development.
EXPO_PUBLIC_API_URL=https://api.example.com

# Stripe publishable key (pk_...) for adding a card with the Payment Sheet. Never put the secret key here.
# Card entry needs a development build (npx expo run:android / run:ios), not Expo Go.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
